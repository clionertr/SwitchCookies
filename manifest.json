{
  "manifest_version": 3,
  "name": "SwitchCookies",
  "version": "2.0.0",
  "description": "一键保存并切换网站登录状态（Cookie + localStorage + sessionStorage + IndexedDB）",
  "minimum_chrome_version": "119",
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}